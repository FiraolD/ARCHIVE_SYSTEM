# Copy this file to .env and replace every placeholder with local values.
# Never commit real credentials or production connection strings.

PORT=7000
NODE_ENV=development
HOST=127.0.0.1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurearch
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Upload settings
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=10485760

# URLs
API_URL=http://localhost:7000
FRONTEND_URL=http://localhost:3009
# Add additional allowed browser origins here, comma-separated.
# CORS_ORIGINS=https://archive.example.com

# Required only when setupDatabase.js needs to create these seed accounts.
# Use different, unique passwords of at least 16 characters; do not use defaults.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# SEED_ADMIN_PASSWORD=
# SEED_AGENT_PASSWORD=
