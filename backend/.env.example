# Copy this file to .env and fill in real values. NEVER commit .env.

# Server Configuration
PORT=7000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurearch
DB_USER=postgres
DB_PASSWORD=Fira@0412

# JWT Configuration (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# File Upload
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=10485760

# API URL
API_URL=http://localhost:7000, http://10.1.12.21:7000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3009, http://10.1.12.21:3009

# Additional allowed CORS origins, comma-separated (optional)
# CORS_ORIGINS=https://archive.example.com

# Optional seed passwords for db:setup (defaults: admin123 / agent123 - change in production)
# SEED_ADMIN_PASSWORD=
# SEED_AGENT_PASSWORD=
