# Copy this file to .env and replace every placeholder with local values.
# Never commit real credentials or production connection strings.

PORT=5000
NODE_ENV=development
HOST=0.0.0.0
FRONTEND_PORT=3009
# Set only when running behind a known reverse proxy.
# TRUST_PROXY_HOPS=1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurearch
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=8h
SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_characters
SEED_AGENT_PASSWORD=replace_with_a_different_unique_password_at_least_16_characters

# Upload settings (MAX_FILE_SIZE is bytes; document files are stored outside backend/uploads)
UPLOAD_DIR=private_uploads
MAX_FILE_SIZE=10485760

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3009, http://10.1.12.21:3009
# Add additional allowed browser origins here, comma-separated.
# CORS_ORIGINS=https://archive.example.com
